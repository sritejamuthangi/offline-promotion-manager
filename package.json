{
  "name": "offline-promotion-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source design and print studio that runs entirely on your device. Make posters, flyers, cards, certificates and more, then print them at any size.",
  "license": "MIT",
  "author": {
    "name": "Sriteja Muthangi",
    "url": "https://www.linkedin.com/in/sritejamuthangi/"
  },
  "keywords": [
    "design",
    "print",
    "templates",
    "poster",
    "flyer",
    "offline",
    "local-first",
    "pwa"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
