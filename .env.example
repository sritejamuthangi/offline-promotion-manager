# Copy these to .env.production, or set them in your host's build settings.

# Public site URL used for canonical links, the sitemap and robots.txt.
VITE_SITE_URL=https://opm.sritejam.com

# Build output path when hosting in a sub-folder, for example /studio/.
VITE_BASE_PATH=/

# Google Search Console verification: the content value of the meta tag it shows.
# Leave empty to omit the tag. See docs/DEPLOYMENT.md for the other methods.
VITE_GOOGLE_SITE_VERIFICATION=
